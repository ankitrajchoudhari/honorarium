PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled in Phase 6 after the sandbox webhook is created on the deployed URL
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
# Exact model code from AI Studio, e.g. gemini-3.5-flash-lite
GEMINI_MODEL=
# Neon pooled connection string
DATABASE_URL=
APP_BASE_URL=http://localhost:3000
# 32+ random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
AI_DAILY_CALL_LIMIT=400
# Comma-separated US personal sandbox account emails (Phase 2)
SANDBOX_RECEIVERS=
